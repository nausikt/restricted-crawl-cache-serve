# Auto-generated by RCCS — do not edit manually.
# Regenerate with: rccs generate --config <archi-config.yaml>
#
# The mirror is served ONLY on the private container network
# `{{ network_name }}` — no host ports are published.  To reach it:
#
#   - Put archi / other consumers on the same external network.
#   - For ad-hoc access:
#         podman run -it --rm --no-hosts --network {{ network_name }} \
#             curlimages/curl curl http://<alias>/...
#
# Create the network once before `compose up`:
#
#     rccs net up
#     # or manually:
#     podman network create --internal {{ network_name }}
#
# Absolute volume paths are baked in at generate time so this file is
# self-contained and `(docker|podman) compose -f <path>/compose.yaml up`
# works from any directory.
#
#   mirror host path       -> {{ mirror_root }}
#   generated outputs dir  -> {{ generated_output_dir }}
services:
  mirror:
    image: nginx:alpine
    container_name: rccs-mirror
    volumes:
      - {{ mirror_root }}:/usr/share/nginx/html:ro
      - {{ nginx_sites_dir }}:/etc/nginx/conf.d:ro
    networks:
      {{ network_name }}:
        aliases:
{%- for alias in aliases %}
          - {{ alias }}
{%- endfor %}

networks:
  {{ network_name }}:
    name: {{ network_name }}
    # `external: true` means compose does not manage this network's lifecycle.
    # Create it with `rccs net up` (which uses `--internal` to block egress)
    # so archi or other consumers can attach to the same network.
    external: true
